{
  "$schema": "../site/node_modules/wrangler/config-schema.json",
  "name": "decomp-redirect",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "routes": [
    { "pattern": "decomp.online/*", "zone_name": "decomp.online" },
    { "pattern": "www.decomp.online/*", "zone_name": "decomp.online" },
    { "pattern": "www.decomp.wtf", "custom_domain": true }
  ]
}
