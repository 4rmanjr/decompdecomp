{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "decompdecomp-site",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  // Static files only: no Worker code runs.
  "routes": [{ "pattern": "decomp.ndelic.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
